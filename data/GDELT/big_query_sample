-- GDELT 2.0 Protest and Demonstration Events Query 
-- Covers February 2015 to present (GDELT 2.0 timeframe)
-- Focuses strictly on protest/demonstration event codes

SELECT 
    -- Time and identification
    GLOBALEVENTID,
    SQLDATE,
    MonthYear,
    Year,
    FractionDate,
    
    -- Actor information
    Actor1Code,
    Actor1Name,
    Actor1CountryCode,
    Actor1KnownGroupCode,
    Actor1EthnicCode,
    Actor1Religion1Code,
    Actor1Religion2Code,
    Actor1Type1Code,
    Actor1Type2Code,
    Actor1Type3Code,
    
    Actor2Code,
    Actor2Name,
    Actor2CountryCode,
    Actor2KnownGroupCode,
    Actor2EthnicCode,
    Actor2Religion1Code,
    Actor2Religion2Code,
    Actor2Type1Code,
    Actor2Type2Code,
    Actor2Type3Code,
    
    -- Event classification
    IsRootEvent,
    EventCode,
    EventBaseCode,
    EventRootCode,
    QuadClass,
    GoldsteinScale,
    NumMentions,
    NumSources,
    NumArticles,
    AvgTone,
    
    -- Geographic data
    Actor1Geo_Type,
    Actor1Geo_Fullname,
    Actor1Geo_CountryCode,
    Actor1Geo_ADM1Code,
    Actor1Geo_ADM2Code,
    Actor1Geo_Lat,
    Actor1Geo_Long,
    Actor1Geo_FeatureID,
    
    Actor2Geo_Type,
    Actor2Geo_Fullname,
    Actor2Geo_CountryCode,
    Actor2Geo_ADM1Code,
    Actor2Geo_ADM2Code,
    Actor2Geo_Lat,
    Actor2Geo_Long,
    Actor2Geo_FeatureID,
    
    ActionGeo_Type,
    ActionGeo_Fullname,
    ActionGeo_CountryCode,
    ActionGeo_ADM1Code,
    ActionGeo_ADM2Code,
    ActionGeo_Lat,
    ActionGeo_Long,
    ActionGeo_FeatureID,
    
    -- Source information
    SOURCEURL,
    DATEADDED

FROM `gdelt-bq.gdeltv2.events`

WHERE 
    -- Focus on UK events (action location in UK); but you need to change the country code
    (ActionGeo_CountryCode = 'UK' OR ActionGeo_CountryCode = 'GB')

    -- Protest and demonstration event codes (14x series only)
    AND (
        EventCode LIKE '14%'  -- All protest events
        OR EventCode IN (
            '140', -- Engage in political dissent
            '141', -- Demonstrate or rally
            '1411', '1412', '1413', '1414',  -- Demonstrate or rally subcategories
            '142', -- Conduct hunger strike
            '1421', '1422', '1423', '1424',  -- Hunger strike subcategories
            '143', -- Conduct strike or boycott
            '1431', '1432', '1433', '1434',  -- Strike/boycott subcategories
            '144', -- Obstruct passage, block
            '1441', '1442', '1443', '1444',  -- Obstruct passage subcategories
            '145', -- Protest violently, riot
            '1451', '1452', '1453', '1454'   -- Violent protest subcategories
        )
        -- Only include 133 if you specifically want "threaten with protest"
        -- OR EventCode = '133' -- Threaten with political dissent, protest
        -- I excluded this because it was just not necessary
    )
    
    -- Date range (GDELT 2.0 starts February 19, 2015)
    AND SQLDATE >= 20150219
    
    -- Ensure we have geographic data for the event location
    AND ActionGeo_Lat IS NOT NULL 
    AND ActionGeo_Long IS NOT NULL

ORDER BY SQLDATE DESC, GLOBALEVENTID;

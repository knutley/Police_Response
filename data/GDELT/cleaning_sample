# SMART URL VALIDATION FUNCTIONS
# =============================================================================

#' Validate URLs using smart pre-filtering and selective HTTP validation
#' 
#' @param urls Character vector of URLs to validate
#' @param sample_validate Number of non-reliable URLs to HTTP validate
#' @param timeout HTTP request timeout in seconds
#' @param reliability_threshold Success rate threshold for accepting all URLs
#' @param verbose Print progress messages
#' @param custom_reliable_domains Additional reliable domains to include
#' @return Logical vector indicating which URLs are valid
validate_urls_smart <- function(urls, 
                                sample_validate = 1000, 
                                timeout = 3, 
                                reliability_threshold = 0.4,
                                verbose = TRUE,
                                custom_reliable_domains = NULL) {
  
  if (length(urls) == 0) return(logical(0))
  
  # Step 1: Basic pre-filtering
  if (verbose) cat("Step 1: Pre-filtering URLs...\n")
  
  urls <- trimws(urls)
  urls[is.na(urls) | urls == ""] <- NA
  
  # Basic format validation
  valid_pattern <- grepl("^https?://[a-zA-Z0-9.-]+\\.[a-zA-Z]{2,}", urls, ignore.case = TRUE)
  non_empty <- !is.na(urls)
  reasonable_length <- nchar(urls) > 10 & nchar(urls) < 2000
  no_spaces <- !grepl(" ", urls)
  not_ip_only <- !grepl("^https?://[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}/?$", urls)
  has_proper_tld <- grepl("\\.[a-zA-Z]{2,}(?:/|$)", urls)
  
  prefilter_valid <- valid_pattern & non_empty & reasonable_length & no_spaces & not_ip_only & has_proper_tld
  
  if (verbose) {
    removed_count <- sum(!prefilter_valid, na.rm = TRUE)
    remaining_count <- sum(prefilter_valid, na.rm = TRUE)
    cat("Pre-filtering removed", removed_count, "URLs, leaving", remaining_count, "to check\n")
  }
  
  # Step 2: Domain-based validation
  if (verbose) cat("Step 2: Domain-based validation...\n")
  
  extract_domain <- function(url) {
    if (is.na(url)) return(NA)
    domain <- gsub("^https?://(?:www\\.)?", "", url, ignore.case = TRUE, perl = TRUE)
    domain <- gsub("/.*$", "", domain)
    return(tolower(domain))
  }
  
  domains <- sapply(urls[prefilter_valid], extract_domain, USE.NAMES = FALSE)
  
  # Default reliable domains (expand as needed)
  default_reliable_domains <- c(
    # Major news outlets
    "bbc.co.uk", "bbc.com", "theguardian.com", "guardian.co.uk", "reuters.com",
    "ap.org", "cnn.com", "sky.com", "skynews.com", "independent.co.uk",
    "telegraph.co.uk", "ft.com", "economist.com", "metro.co.uk",
    "dailymail.co.uk", "mirror.co.uk", "express.co.uk", "itv.com",
    "channel4.com", "huffingtonpost.co.uk", "politico.eu", "politico.com",
    
    # Regional news
    "liverpoolecho.co.uk", "manchestereveningnews.co.uk", "birminghammail.co.uk",
    "bristolpost.co.uk", "chroniclelive.co.uk", "hulldailymail.co.uk",
    "nottinghampost.com", "derbytelegraph.co.uk", "coventrytelegraph.net",
    "yorkshirepost.co.uk", "theargus.co.uk", "bournemouthecho.co.uk",
    
    # News aggregators
    "news.google.com", "uk.news.yahoo.com", "msn.com", "aol.co.uk",
    "pressassociation.com", "pa.media"
  )
  
  # Combine with custom domains
  reliable_domains <- c(default_reliable_domains, custom_reliable_domains)
  domain_reliable <- domains %in% reliable_domains
  
  # Step 3: Selective HTTP validation
  if (verbose) cat("Step 3: HTTP validation of sample...\n")
  
  final_valid <- logical(length(urls))
  reliable_indices <- which(prefilter_valid)[domain_reliable]
  final_valid[reliable_indices] <- TRUE
  
  non_reliable_indices <- which(prefilter_valid)[!domain_reliable]
  
  if (length(non_reliable_indices) > 0) {
    sample_size <- min(sample_validate, length(non_reliable_indices))
    sample_indices <- sample(non_reliable_indices, sample_size)
    
    if (verbose) {
      cat("HTTP validating", length(sample_indices), "URLs from non-reliable domains...\n")
    }
    
    http_valid <- logical(length(sample_indices))
    
    for (i in seq_along(sample_indices)) {
      url <- urls[sample_indices[i]]
      
      if (i %% 50 == 0 && verbose) {
        cat("Validated", i, "of", length(sample_indices), "URLs\n")
      }
      
      tryCatch({
        response <- HEAD(url, timeout(timeout), 
                         config(ssl_verifypeer = FALSE, followlocation = TRUE))
        status_code <- status_code(response)
        http_valid[i] <- status_code >= 200 & status_code < 400
      }, error = function(e) {
        http_valid[i] <- FALSE
      })
      
      if (i %% 20 == 0) Sys.sleep(0.05)
    }
    
    success_rate <- sum(http_valid) / length(http_valid)
    
    if (verbose) {
      cat("HTTP validation success rate:", round(success_rate * 100, 1), "%\n")
    }
    
    # Apply strategy based on success rate
    if (success_rate >= reliability_threshold) {
      final_valid[non_reliable_indices] <- TRUE
      if (verbose) cat("Success rate above threshold - accepting all pre-filtered URLs\n")
    } else if (success_rate >= (reliability_threshold / 2)) {
      final_valid[sample_indices] <- http_valid
      if (verbose) cat("Moderate success rate - only accepting HTTP-validated URLs\n")
    } else {
      if (verbose) cat("Low success rate - rejecting non-reliable domains\n")
    }
  }
  
  if (verbose) {
    valid_count <- sum(final_valid)
    total_count <- length(urls)
    cat("Final result:", valid_count, "valid URLs out of", total_count, "total URLs\n")
    cat("Acceptance rate:", round(valid_count/total_count * 100, 1), "%\n")
  }
  
  return(final_valid)
}


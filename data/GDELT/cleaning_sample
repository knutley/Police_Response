#' Deduplicate GDELT data using configurable strategies
#' 
#' @param df Data frame to deduplicate
#' @param methods Vector of deduplication methods to apply
#' @param date_col Name of date column
#' @param url_col Name of URL column
#' @param event_cols Character vector of columns that define unique events
#' @param location_cols Character vector of latitude/longitude column names
#' @param quality_cols Character vector of columns to use for selecting best records
#' @param verbose Print progress messages
#' @return Deduplicated data frame
deduplicate_gdelt <- function(df, 
                              methods = c("exact", "event", "url"),
                              date_col = "SQLDATE",
                              url_col = "SOURCEURL",
                              event_cols = c("EventCode", "Actor1Code", "Actor2Code"),
                              location_cols = c("ActionGeo_Lat", "ActionGeo_Long"),
                              quality_cols = c("NumSources", "GoldsteinScale"),
                              verbose = TRUE) {
  
  if(verbose) cat("Starting deduplication with", nrow(df), "rows\n")
  
  # Method 1: Exact duplicates
  if("exact" %in% methods) {
    initial_rows <- nrow(df)
    df <- df %>% distinct()
    if(verbose) cat("Removed", initial_rows - nrow(df), "exact duplicates\n")
  }
  
  # Method 2: Event-based deduplication
  if("event" %in% methods) {
    initial_rows <- nrow(df)
    
    # Build grouping columns dynamically
    group_cols <- c(date_col, event_cols, location_cols)
    group_cols <- group_cols[group_cols %in% names(df)]
    
    if(length(group_cols) > 0) {
      df <- df %>%
        group_by(across(all_of(group_cols))) %>%
        arrange(across(all_of(quality_cols), desc)) %>%
        slice(1) %>%
        ungroup()
      if(verbose) cat("Removed", initial_rows - nrow(df), "event-based duplicates\n")
    }
  }
  
  # Method 3: URL-based deduplication
  if("url" %in% methods && url_col %in% names(df)) {
    initial_rows <- nrow(df)
    
    df_with_url <- df %>% 
      filter(!is.na(!!sym(url_col)) & !!sym(url_col) != "")
    df_without_url <- df %>% 
      filter(is.na(!!sym(url_col)) | !!sym(url_col) == "")
    
    if(nrow(df_with_url) > 0) {
      df_with_url <- df_with_url %>%
        group_by(!!sym(url_col)) %>%
        arrange(across(all_of(quality_cols), desc)) %>%
        slice(1) %>%
        ungroup()
    }
    
    df <- bind_rows(df_with_url, df_without_url)
    if(verbose) cat("Removed", initial_rows - nrow(df), "URL-based duplicates\n")
  }
  
  if(verbose) cat("Final dataset has", nrow(df), "rows\n")
  return(df)
}

#' Advanced deduplication with fuzzy matching for similar events
#' 
#' @param df Data frame to deduplicate
#' @param date_window Number of days to consider for temporal matching
#' @param distance_km Distance threshold in kilometers for spatial matching
#' @param chunk_size Process data in chunks of this size for memory efficiency
#' @param verbose Print progress messages
#' @return Deduplicated data frame
advanced_deduplicate <- function(df, 
                                 date_window = 1, 
                                 distance_km = 5, 
                                 chunk_size = 5000,
                                 verbose = TRUE) {
  
  if(verbose) cat("Starting advanced deduplication with", nrow(df), "rows\n")
  
  # First do basic deduplication
  df <- deduplicate_gdelt(df, verbose = FALSE)
  
  # Process in chunks if dataset is large
  if(nrow(df) <= chunk_size) {
    result <- process_fuzzy_duplicates(df, date_window, distance_km, verbose)
  } else {
    if(verbose) cat("Processing in chunks of", chunk_size, "rows\n")
    
    results <- list()
    for(i in seq(1, nrow(df), chunk_size)) {
      end_idx <- min(i + chunk_size - 1, nrow(df))
      chunk <- df[i:end_idx, ]
      results[[length(results) + 1]] <- process_fuzzy_duplicates(chunk, date_window, distance_km, FALSE)
      
      if(verbose) cat("Processed chunk", length(results), "of", ceiling(nrow(df)/chunk_size), "\n")
    }
    result <- do.call(rbind, results)
  }
  
  if(verbose) cat("Final dataset has", nrow(result), "rows\n")
  return(result)
}

#' Helper function to process fuzzy duplicates within a chunk
process_fuzzy_duplicates <- function(df, date_window, distance_km, verbose) {
  
  dt <- as.data.table(df)
  dt[, `:=`(
    date_num = as.numeric(as.Date(as.character(SQLDATE), format = "%Y%m%d")),
    row_id = .I
  )]
  
  duplicates_to_remove <- c()
  
  for(i in 1:(nrow(dt)-1)) {
    if(i %in% duplicates_to_remove) next
    
    current_row <- dt[i]
    
    similar_events <- dt[(i+1):nrow(dt)][
      abs(date_num - current_row$date_num) <= date_window &
        EventCode == current_row$EventCode &
        Actor1Code == current_row$Actor1Code &
        Actor2Code == current_row$Actor2Code
    ]
    
    if(nrow(similar_events) > 0) {
      similar_events[, distance := sqrt(
        (ActionGeo_Lat - current_row$ActionGeo_Lat)^2 + 
          (ActionGeo_Long - current_row$ActionGeo_Long)^2
      ) * 111]
      
      close_events <- similar_events[distance <= distance_km]
      if(nrow(close_events) > 0) {
        duplicates_to_remove <- c(duplicates_to_remove, close_events$row_id)
      }
    }
  }
  
  if(length(duplicates_to_remove) > 0) {
    dt <- dt[!row_id %in% duplicates_to_remove]
  }
  
  dt[, `:=`(date_num = NULL, row_id = NULL)]
  return(as.data.frame(dt))
}

# =============================================================================
# MAIN PIPELINE FUNCTION
# =============================================================================

#' Complete GDELT cleaning pipeline
#' 
#' @param data Data frame containing GDELT data
#' @param url_col Name of URL column to validate
#' @param validate_urls Whether to perform URL validation
#' @param dedup_methods Vector of deduplication methods to apply
#' @param url_validation_params List of parameters for URL validation
#' @param dedup_params List of parameters for deduplication
#' @param verbose Print progress messages
#' @return Cleaned data frame with validation and deduplication results
clean_gdelt_data <- function(data,
                             url_col = "SOURCEURL",
                             validate_urls = TRUE,
                             dedup_methods = c("exact", "event"),
                             url_validation_params = list(),
                             dedup_params = list(),
                             verbose = TRUE) {
  
  if(verbose) cat("=== GDELT Data Cleaning Pipeline ===\n")
  if(verbose) cat("Starting with", nrow(data), "rows\n\n")
  
  result <- data
  
  # URL Validation
  if(validate_urls && url_col %in% names(data)) {
    if(verbose) cat("--- URL Validation ---\n")
    
    # Set default parameters
    url_params <- list(
      sample_validate = 1000,
      timeout = 3,
      reliability_threshold = 0.4,
      verbose = verbose
    )
    url_params <- modifyList(url_params, url_validation_params)
    
    # Validate URLs
    url_results <- do.call(validate_urls_smart, 
                           c(list(urls = data[[url_col]]), url_params))
    
    result$url_valid <- url_results
    result <- result[result$url_valid == TRUE, ]
    
    if(verbose) {
      cat("URL validation retained", nrow(result), "rows (", 
          round(nrow(result)/nrow(data) * 100, 1), "%)\n\n")
    }
  }
  
  # Deduplication
  if(length(dedup_methods) > 0) {
    if(verbose) cat("--- Deduplication ---\n")
    
    # Set default parameters
    dedup_params_default <- list(
      methods = dedup_methods,
      verbose = verbose
    )
    dedup_params <- modifyList(dedup_params_default, dedup_params)
    
    # Deduplicate
    result <- do.call(deduplicate_gdelt, 
                      c(list(df = result), dedup_params))
  }
  
  # Summary
  if(verbose) {
    cat("\n=== FINAL SUMMARY ===\n")
    cat("Original dataset:", nrow(data), "rows\n")
    cat("Final dataset:", nrow(result), "rows\n")
    cat("Total removed:", nrow(data) - nrow(result), "rows\n")
    cat("Retention rate:", round(nrow(result)/nrow(data) * 100, 1), "%\n")
  }
  
  return(result)
}

